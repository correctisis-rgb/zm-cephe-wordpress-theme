{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "siteOptions": {
    "blogname": "ZM Alüminyum Cephe Sistemleri",
    "blogdescription": "Alüminyum Cephe Sistemleri & Mimarlık"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "tr_TR"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/correctisis-rgb/zm-cephe-wordpress-theme",
        "ref": "main",
        "path": ""
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_person \"Recep KARAMANLI\""
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_phone \"0541 711 35 37\""
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_email \"recep@zmcephe.com\""
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_website \"https://www.zmcephe.com\""
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_address \"Cami Mh. Göktaş Sk. No:43/1 Darıca/KOCAELİ\""
    },
    {
      "step": "wp-cli",
      "command": "wp option update admin_email recep@zmcephe.com"
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_stat_team 100"
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_stat_experience 25"
    },
    {
      "step": "wp-cli",
      "command": "wp theme mod set zm_stat_projects 141"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Ana Sayfa' --post_name=anasayfa --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Hakkımızda' --post_name=hakkimizda --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Sistemler' --post_name=sistemler --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Projeler' --post_name=projeler --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='İletişim' --post_name=iletisim --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp user meta update 1 show_admin_bar_front 0"
    },
    {
      "step": "wp-cli",
      "command": "wp option update show_on_front page"
    },
    {
      "step": "runPHP",
      "code": "require '/wordpress/wp-load.php'; $page = get_page_by_path('anasayfa'); if ($page) { update_option('page_on_front', $page->ID); }"
    },
    {
      "step": "runPHP",
      "code": "require_once '/wordpress/wp-load.php'; $css = '#wpadminbar{display:none!important} html{margin-top:0!important}'; wp_update_custom_css_post($css);"
    }
  ]
}
